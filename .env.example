# Copy to .env for local job runs (npm run job:weekly-run). Never commit .env (NFR-06).
# Comments sit on their own lines because some .env readers do not allow them after a value.

# Local Supabase (supabase status shows both values) or a hosted project's API settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without a key, drafts use the fallback templates (FR-09).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# AI-09: low randomness. Set to "off" to use the model's default.
AI_TEMPERATURE=0.3
AI_CONCURRENCY=3

# Optional. Without a key, emails are printed instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Get-Paid Apprentice <briefing@example.com>"
APP_URL=http://localhost:5173

# The team's alert address for late briefings and failed jobs (NFR-10).
ALERT_EMAIL=
