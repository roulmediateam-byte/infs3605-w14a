# Copy to .env.local (never commit it). Values are public by design: the publishable key is safe in a browser and
# the data stays behind row-level security (TRD, Web app). No other secret belongs in this app (NFR-06).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Where "Contact the team" under More sends email. Leave empty to show the team channel instead.
VITE_SUPPORT_EMAIL=support@getpaid.example
# Screens to hide until they ship (the Week 7 demonstration build hides these three).
VITE_HIDE_SCREENS=
