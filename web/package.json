{
  "name": "getpaid-apprentice-web",
  "version": "0.1.0",
  "private": true,
  "description": "Get-Paid Apprentice web app: screens UI-01 to UI-11 (Team W14A-5, INFS3605, UNSW).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "node scripts/build-e2e.ts",
    "build:pages-e2e": "node scripts/build-pages-e2e.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "size": "node scripts/check-size.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.57.0",
    "papaparse": "5.5.5",
    "react": "19.2.9",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
